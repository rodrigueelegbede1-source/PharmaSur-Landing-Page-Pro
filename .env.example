# Endpoint qui reçoit les numéros saisis dans le formulaire de bas de page.
#
# Laissez la valeur vide en développement : le formulaire valide le numéro et
# affiche la confirmation sans envoyer quoi que ce soit.
#
# Provisoire — service de formulaire hébergé (Formspree) :
#   VITE_LEAD_ENDPOINT=https://formspree.io/f/xxxxxxx
#
# Définitif — backend PharmaSur, une fois en ligne :
#   VITE_LEAD_ENDPOINT=https://api.pharmasur.ci/leads
#
# ATTENTION : toute variable préfixée VITE_ est intégrée au JavaScript public du
# site, donc lisible par n'importe qui. N'y placez jamais une clé secrète.
VITE_LEAD_ENDPOINT=
