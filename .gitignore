# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Lien vers le projet Vercel, propre à chaque machine
.vercel

# Canevas de maquettes assemblés : 2,5 Mo chacun, régénérables depuis les .dc.html
design/maquettes-app/pharmasur-application-patient.html
design/maquettes-console/pharmasur-console-pharmacie.html

# Outillage de fabrication des visuels : installé au besoin, jamais livré
design/node_modules
design/PlusJakartaSans.ttf
design/package*.json

# Projet Android : seul twa-manifest.json est versionné, tout le reste est
# regénéré par « bubblewrap update ». Les APK et les clés ne le sont jamais.
android/*
!android/twa-manifest.json
*.apk
*.aab
*.keystore
*.jks

# Exception : l'APK servi aux visiteurs. Vercel construit depuis git — un
# fichier non versionné n'est jamais déployé, et le bouton renverrait un 404.
!public/*.apk

# Variables d'environnement (seul .env.example est versionné)
.env
.env.*
!.env.example

# Editor directories and files
.claude
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*
